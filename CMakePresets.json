{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "AM335x Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AM335X_BSP_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "AM335x RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-relwithdebinfo",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "AM335X_BSP_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "AM335x Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AM335X_BSP_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}